BEGIN_HYPERDESC
<h1>Orbit MFD input test scene</h1>
A delta-glider in a 300 km Earth orbit, glass cockpit with Orbit MFDs,
for Tests/Input/OrbitMFD.input.
END_HYPERDESC

BEGIN_ENVIRONMENT
  System Sol
  Date MJD 51982.6685767396
END_ENVIRONMENT

BEGIN_FOCUS
  Ship GL-I
END_FOCUS

BEGIN_CAMERA
  TARGET GL-I
  MODE Cockpit
  FOV 50.00
END_CAMERA

BEGIN_MFD Left
  TYPE Orbit
  PROJ Frame
  FRAME Ecliptic
  REF Earth
END_MFD

BEGIN_MFD Right
  TYPE Orbit
  PROJ Ship
  FRAME Ecliptic
  REF Earth
END_MFD

BEGIN_SHIPS
GL-I:DeltaGlider
  STATUS Orbiting Earth
  ELEMENTS 6671000.0 0.00000 51.6 30.0 0.0 100.0 51982.6685767396
  AROT 0 0 0
  PRPLEVEL 0:1.000 1:1.000
  NAVFREQ 0 0
END
END_SHIPS
