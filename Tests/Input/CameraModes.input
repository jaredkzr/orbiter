wait 3
lua sample ()
lua check ("flyby_ahead", mode () == "flyby" and fmax > 100, string.format ("ahead at most %.0f m", fmax))
lua check ("flyby_passed", fmin < 0, string.format ("ahead at least %.0f m", fmin))
lua check ("flyby_again", jumps >= 1, string.format ("put ahead again %d times", jumps))
exit
