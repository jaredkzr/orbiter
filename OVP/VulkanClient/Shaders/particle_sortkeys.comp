// GPU particles: the particles to draw as sprites, compacted into a list
// (over the allocated blocks), with their sort keys: the distance from the
// camera (decreasing: drawn far to near, all rings together). The list's
// length is the instance count of the indirect draw; keys up to the sort's
// size beyond it were set to the largest (last). In the smoke volume's
// mode its volumetric particles within reach are left out (gpuparticle.vert
// draws them only beyond 16 km).

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#include "particle_common.glsl"
layout(set = 0, binding = 8, std430) buffer SortVals { uint vals[]; };
layout(set = 0, binding = 9, std430) buffer SortKeys { uint keys[]; };
layout(set = 0, binding = 21, std430) buffer DrawArgs { uint vertexCount, instanceCount, firstVertex, firstInstance; } draw;

shared uint wgLive, wgVol, wgDraw, wgBase; // (telemetry; the workgroup's sprites)

void main ()
{
	bool stats = statsOn != 0u;
	if (gl_LocalInvocationIndex == 0u) wgLive = 0u, wgVol = 0u, wgDraw = 0u;
	barrier ();
	uint i = ParticleSlot (gl_GlobalInvocationID.x);
	bool drawn = false;
	uint key = 0u, at = 0u;
	if (i != ~0u) {
		Particle p = particles[i];
		if (p.velLife.w > 0.0) {
			if (stats) {
				atomicAdd (wgLive, 1u);
				if ((p.flags & PF_VOLUMETRIC) != 0u) atomicAdd (wgVol, 1u);
			}
			drawn = ParticleAlpha (p) > 0.002;
			if (drawn && (p.flags & PF_VOLUMETRIC) != 0u && pc.ground.w > 0.5)
				drawn = length (p.posAge.xyz) > VolHandoff (p.flags).x * 0.99; // (gpuparticle.vert: from the hand-off on)
			if (drawn) {
				float z = max (dot (p.posAge.xyz, frame.viewToGlobal[2].xyz), 0.0);
				float q = clamp (log2 (z + 1.0) / 17.0, 0.0, 1.0); // (up to about 130 km)
				key = 0x3FFFFFFEu - uint (q * float (0x3FFFFFFE));
				at = atomicAdd (wgDraw, 1u);
			}
		}
	}
	barrier ();
	if (gl_LocalInvocationIndex == 0u) {
		if (wgDraw > 0u) wgBase = atomicAdd (draw.instanceCount, wgDraw);
		if (stats && wgLive > 0u) {
			atomicAdd (liveCount, wgLive);
			atomicAdd (liveVol, wgVol);
		}
	}
	barrier ();
	if (drawn) {
		uint k = wgBase + at;
		if (k < uint (pc.ground.z)) keys[k] = key, vals[k] = i; // (more than the sort's size: not drawn, gpuparticle.vert)
	}
}
