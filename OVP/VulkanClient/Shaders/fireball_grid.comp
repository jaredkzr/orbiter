// Crash fireballs (Fireball.cpp): the grid of each fireball filled from its
// procedural model, at its age (the same at any frame rate; frozen while
// paused):
// - its shape: a ball of radius r drawn out along its path (the fuel thrown
//   on with the wreck), flattened as it lifts off into a cap, its base drawn
//   in from below (the inflow of a rising vortex ring)
// - its billows: the surface pushed out and in by noise of three sizes
//   (large lobes, billows, small cauliflower), the noise's coordinates
//   warped by a slowly boiling field (no two lobes alike) and carried by
//   the flow: outward from the centre (features emerging from inside and
//   pushing out, keeping their shape: two phases of an even scaling,
//   cross-faded) and, as it lifts, turned about the ring's core (the
//   outside rolling down and under, the inside rising)
// - how far each part of it burned (the progress c: 0 burning, 1 burned
//   out): the outer layer and the top first, in lanes and patches by noise;
//   its temperature falling from the hottest gas's to soot's (900 K) with
//   it, its soot rising with it
// Out: A (density 0..1, temperature [kK], soot 0..1, -), C (the warp of
// the noise's coordinates, for the march's detail, -)

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "frame.glsl"
#define FB_SET 1
#define FB_BINDING 6
#include "fireball.glsl"

layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D outA;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image3D outC;
layout(set = 1, binding = 4) uniform sampler3D shapeNoise;  // 128^3 Perlin-Worley (billowy), repeating
layout(set = 1, binding = 5) uniform sampler3D detailNoise; // 32^3 Worley fBm, repeating

layout(push_constant) uniform Pass {
	uint base;   // the frame slot's first fireball
	uint count;
} pc;

// the noise volumes normalized: mean 0, about +-1 (two standard deviations)
// (the shape noise's values: mean 0.67, sd 0.073; the detail's 0.475, 0.12)
float Sh (vec3 x) { return clamp ((textureLod (shapeNoise, x, 0.0).r - 0.67) * 6.8, -1.3, 1.3); }
float Dt (vec3 x) { return clamp ((textureLod (detailNoise, x, 0.0).r - 0.475) * 4.2, -1.3, 1.3); }
#include "fireball_flow.glsl"

void main ()
{
	ivec3 id = ivec3 (gl_GlobalInvocationID);
	uint k = uint (id.z / FB_GZ);
	if (k >= pc.count || id.x >= FB_GX || id.y >= FB_GY) return;
	FireballParams P = fireballs[pc.base + k];
	vec3 uvw = (vec3 (id.x, id.y, id.z % FB_GZ) + 0.5) / vec3 (FB_GX, FB_GY, FB_GZ);
	vec3 p = mix (P.boxMin.xyz, P.boxMax.xyz, uvw); // ball space [m]
	float r = P.shape.x, e = P.shape.z, L = P.shape.w, u = P.time.y;
	vec3 seed = fract (vec3 (0.137, 0.291, 0.443) * P.time.w);
	// (in units of 0.9 r: its billows reach out to about 1.3 of the shape's
	// radius - seen, it was a fifth larger than the model's ball)
	vec3 x = p / (0.9 * r);
	// its lean: the top carried on ahead of its foot (the shape evaluated
	// behind: what is drawn here leans the other way)
	x.xy -= P.asym.xy * max (x.z + 0.6, 0.0);
	if (P.mode.x > 0.5) {
		// in vacuum (PLAN.md 2.7): nothing holds the burning propellant
		// together - a thin shell of it expanding, ragged by the noise,
		// its gas cooling (the march: white as it flashes, then a pale
		// vapour shell by its opacity, fading)
		float rs = P.mode.y, w = max (P.mode.z, 0.01);
		float dist = length (p);
		float e = (dist - rs) / w;
		vec3 qs = p / max (rs, 1.0) * 1.7 + seed;
		float n1 = Sh (qs), n2 = Dt (qs * 2.3 + seed.zxy);
		float rho = exp (-e * e) * clamp (0.4 + 0.5 * n1 + 0.35 * n2, 0.0, 1.0);
		imageStore (outA, id, vec4 (rho, P.heat.x * 1e-3 * (1.0 + 0.05 * n2), 0.0, 0.0));
		imageStore (outC, id, vec4 (qs, 0.0));
		return;
	}
	// its shape: drawn out along its path, flattened as it lifts off
	vec3 ax = P.axis.xyz;
	float xa = dot (x, ax);
	vec3 xe = x - ax * (xa * (1.0 - 1.0 / e));
	// (flattened as it lifts off into a cap: by widening, an eighth across at
	// full lift - squashing its height shrank the silhouette: phase 4b)
	xe.xy *= 1.0 - 0.12 * L;
	// sub-lobes (phase 4b): three to five bursts of the fuel off its
	// centre, most of them ahead along its path, of differing sizes, each
	// igniting up to 0.2 t_f after the first and lifting unevenly - joined
	// smoothly to the ball: no two fireballs alike, none a ball
	vec3 lobeC[5];
	float lobeR[5];
	int nLobe = 0;
	{
		vec3 perp = normalize (cross (ax, vec3 (0.0, 0.0, 1.0)));
		for (int i = 0; i < 5; i++) {
			vec4 h = fract (sin (vec4 (12.9898, 78.233, 45.164, 94.673) * (P.time.w * 0.173 + float (i) * 1.618 + 0.5)) * 43758.5453);
			vec4 h2 = fract (sin (vec4 (63.726, 29.512, 81.337, 17.994) * (P.time.w * 0.091 + float (i) * 2.718 + 0.25)) * 24634.6345);
			if (i >= 3 && h.w > 0.55) continue;
			float g = sqrt (clamp ((u - 0.2 * h.x) / 0.25, 0.0, 1.0));
			if (g <= 0.0) continue;
			lobeR[nLobe] = (0.35 + 0.3 * h.y) * g;
			lobeC[nLobe] = g * (ax * ((0.1 + 0.5 * h.z) * (h2.w < 0.7 ? 1.0 : -0.6)) + perp * (0.6 * h2.x - 0.3) + vec3 (0.0, 0.0, 0.4 * h2.y - 0.15 + L * (0.4 * h2.z - 0.1)));
			nLobe++;
		}
	}
	{   // (beyond the reach of its billows, the ball's and its lobes': nothing - the noise not sampled)
		bool far = length (xe) > 1.9;
		for (int i = 0; i < nLobe && far; i++) far = length (xe - lobeC[i]) > 1.9 * lobeR[i];
		if (far) {
			imageStore (outA, id, vec4 (0.0));
			imageStore (outC, id, vec4 (0.0));
			return;
		}
	}

	// the noise's coordinates: carried by the flow (phase 4c). Two phases,
	// each the coordinates scaled down about the centre, evenly, by its age
	// (features emerge from inside and push out keeping their shape - not
	// drawn in by a fixed length, which stretched them along the limb) and,
	// as it lifts, turned about the vortex ring's core by the ring's turn
	// since the phase began (FbRolled); the phases half a period apart,
	// cross-faded, each with its own seed: no stretch ever accumulates. The
	// warp (boiling: a slowly drifting field, no two lobes alike) is one
	// field in ball space, added to both
	// (the warp gentle and broad: at 0.22 of the radius with features of 0.8
	// of it, its gradient reached 1.7 - the noise through it was drawn out
	// into brushed streaks, mostly along the vertical; at 0.12 over features
	// of 1.4 r the stretch stays under about 1.5 - phase 4c)
	float a = P.flow.y;
	float churn = P.flow.z;
	vec3 xs = x * 0.18 + seed;
	vec3 w = vec3 (Sh (xs + vec3 (0.0, 0.0, churn)), Sh (xs + vec3 (0.43, 0.17, 0.61 - churn)), Sh (xs + vec3 (0.71, 0.53, 0.29 + 0.7 * churn))) * (0.12 * P.tune.y);
	vec3 qA = (FbRolled (x, P.adv2.x, a, seed.x) + w) * P.adv.x;
	vec3 qB = (FbRolled (x, P.adv2.y, a, seed.x) + w) * P.adv.z;
	vec3 sdA = seed + FbPhaseSeed (P.adv2.z), sdB = seed + FbPhaseSeed (P.adv2.w);
	float wA = P.adv.y, wB = P.adv.w;
	float wN = inversesqrt (max (wA * wA + wB * wB, 1e-4));
	// (the two phases' noise blended, its variance kept)
#define SH2(k, off) ((wA * Sh (qA * (k) + sdA + (off)) + wB * Sh (qB * (k) + sdB + (off))) * wN)
#define DT2(k, off) ((wA * Dt (qA * (k) + sdA + (off)) + wB * Dt (qB * (k) + sdB + (off))) * wN)

	float d = length (xe);
	// (its base drawn in from below: the inflow under the rising ring)
	float rhe = length (xe.xy);
	d += L * 0.5 * exp (-rhe * rhe / 0.2) * smoothstep (0.3, -0.9, xe.z);
	for (int i = 0; i < nLobe; i++) {
		float di = length (xe - lobeC[i]) / lobeR[i];
		float k = 0.3, hh = clamp (0.5 + 0.5 * (di - d) / k, 0.0, 1.0);
		d = mix (di, d, hh) - k * hh * (1.0 - hh);
	}
	// its billows: lobes, billows, cauliflower (the amplitude varying over
	// it: some parts smoother, others ragged); ragged ahead while it is
	// drawn out (the fuel's spray burning)
	float n1 = SH2 (0.42, vec3 (0.0));
	float n2 = SH2 (1.05, vec3 (0.37, 0.11, 0.29));
	float n3 = DT2 (0.9, vec3 (0.53, 0.07, 0.61));
	float n4 = SH2 (0.2, vec3 (0.5));
	float rag = clamp (1.0 + 0.4 * n4, 0.5, 1.4) * P.tune.x;
	float early = (1.0 - smoothstep (0.0, 0.35, u)) * smoothstep (0.0, 1.0, xa);
	float disp = rag * (0.2 * n1 + 0.11 * n2 + (0.06 + 0.06 * early) * n3);
	float edge = d - disp;
	// (its fading out as it passes to the smoke volume: the march's
	// extinction, not this - fading the density, the erosion cut it into flakes)
	float rho = smoothstep (1.0, 0.92, edge);
	// (none under the ground or the sea: it spreads on it)
	rho *= smoothstep (P.axis.w - 0.02 * r, P.axis.w + 0.1 * r, p.z);
	{   // (and nothing cut flat by the box: faded out over its last cells - phase 4c)
		vec3 size = P.boxMax.xyz - P.boxMin.xyz;
		float cell = min (min (size.x / float (FB_GX), size.y / float (FB_GY)), size.z / float (FB_GZ));
		vec3 fd = min (p - P.boxMin.xyz, P.boxMax.xyz - p);
		rho *= smoothstep (0.0, 3.0 * cell, min (min (fd.x, fd.y), P.boxMax.z - p.z));
	}

	// its temperature: the hot inside, the mixing layer at its surface
	// cooler, steeply under it (seen through about a fourteenth of its
	// radius: each billow's middle hotter than its rim, where the ray grazes
	// the cool layer - limb-darkened, the billows' shapes seen by their
	// light); the layer thinner in places (the hot cores glimpsed,
	// yellow-white), patches hotter and cooler
	float nc = SH2 (0.7, vec3 (0.21, 0.67, 0.43));
	float inner = smoothstep (0.0, clamp (0.16 + 0.12 * n4, 0.04, 0.3), 1.0 - edge);
	float T = mix (P.centre.w, P.heat.x, inner) * (1.0 + 0.04 * n2 - 0.05 * max (nc, 0.0));
	// how far it burned (0 burning, 1 burned out to soot): its mixing layer
	// and its top first, in lanes and patches; the cooled soot at 700 K
	float c = P.heat.y + 0.4 * (edge - 0.75) + 0.3 * L * xe.z + 0.6 * nc;
	c = clamp (c, 0.0, 1.0);
	T = mix (T, 700.0, smoothstep (0.15, 0.9, c));
	// (the flash: all of it white-hot)
	T = mix (T, 2450.0, P.heat.z);
	float soot = smoothstep (0.25, 0.8, c) * (1.0 - P.heat.z);
	imageStore (outA, id, vec4 (rho, T * 1e-3, soot, 0.0));
	imageStore (outC, id, vec4 (w, 0.0));
}
