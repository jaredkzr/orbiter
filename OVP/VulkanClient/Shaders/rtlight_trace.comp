// Ray traced lighting visibility, tracing (one frame's noisy estimate per
// pixel of the prepass): the sun (a ray to a random point of its disc: soft
// shadows that harden at contact), ambient occlusion (a cosine-weighted
// ray within a radius), the lit planet nearby (a ray to a random point of
// its disc, vessels and bases only), and the local lights with shadows (a
// ray from a random point of a small sphere around each).

#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_nonuniform_qualifier : require

#include "rtlight.glsl"

#define FRAME_SET 1
#include "frame.glsl"
#include "swell.glsl"

layout(set = 2, binding = 0) uniform accelerationStructureEXT tlas;
struct RTInstance { uvec2 vtx, idx; uint firstIndex, tex, flags, owner; vec4 diffuse, emissive, pbr, uv, vel; }; // (rt.glsl)
layout(set = 2, binding = 1, std430) readonly buffer Instances { RTInstance inst[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer RTFloats { float f[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer RTUints { uint u[]; };
layout(set = 3, binding = 0) uniform sampler2D rtTex[];
const uint RT_ALPHA = 2u; // (rt.glsl)

// a candidate hit on alpha-tested geometry (foliage) is solid where its texture is
bool CandidateSolid (rayQueryEXT q)
{
	RTInstance r = inst[rayQueryGetIntersectionInstanceCustomIndexEXT (q, false) + rayQueryGetIntersectionGeometryIndexEXT (q, false)];
	if ((r.flags & RT_ALPHA) == 0u) return true;
	uint prim = uint (rayQueryGetIntersectionPrimitiveIndexEXT (q, false));
	vec2 bc = rayQueryGetIntersectionBarycentricsEXT (q, false);
	vec3 w = vec3 (1.0 - bc.x - bc.y, bc.x, bc.y);
	vec2 uv = vec2 (0.0);
	for (int k = 0; k < 3; k++) {
		uint i = r.firstIndex + prim * 3u + uint (k);
		uint word = RTUints (r.idx).u[i >> 1];
		uint vi = ((i & 1u) != 0u ? word >> 16 : word & 0xffffu) * 8u;
		RTFloats v = RTFloats (r.vtx);
		uv += w[k] * vec2 (v.f[vi + 6u], v.f[vi + 7u]);
	}
	return textureLod (rtTex[nonuniformEXT (r.tex)], uv * r.uv.zw + r.uv.xy, 0.0).a >= 0.5;
}

const uint MASK_ALL = 0xFFu, MASK_OBJECTS = 0x01u; // (terrain: 0x02)
const float LIGHT_SHADOW_REACH = 1500.0; // local lights' shadows within this distance of the light [m]
const float PI = 3.14159265;

uvec4 Hash4 (uvec3 v)
{
	uvec4 x = uvec4 (v, v.x ^ v.y);
	x = x * 1664525u + 1013904223u;
	x.x += x.y * x.w; x.y += x.z * x.x; x.z += x.x * x.y; x.w += x.y * x.z;
	x ^= x >> 16u;
	x.x += x.y * x.w; x.y += x.z * x.x; x.z += x.x * x.y; x.w += x.y * x.z;
	return x;
}

// a ray the traversal can take: finite (NaN or infinite origins and
// directions can keep the hardware's traversal from ending: the GPU hangs)
bool RayFinite (vec3 o, vec3 d, float tMax)
{
	return all (lessThan (abs (o), vec3 (1e30))) && all (lessThan (abs (d), vec3 (1e30))) && dot (d, d) > 0.0 && tMax < 1e30;
}

bool Occluded (vec3 o, vec3 d, float tMax, uint mask)
{
	if (!RayFinite (o, d, tMax)) return false;
	rayQueryEXT q;
	// (back faces culled: only stand-ins have them, see RayTracing.cpp)
	rayQueryInitializeEXT (q, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsCullBackFacingTrianglesEXT, mask, o, 0.0, d, tMax);
	while (rayQueryProceedEXT (q))
		if (rayQueryGetIntersectionTypeEXT (q, false) == gl_RayQueryCandidateIntersectionTriangleEXT && CandidateSolid (q))
			rayQueryConfirmIntersectionEXT (q);
	return rayQueryGetIntersectionTypeEXT (q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// Interpolated vertex normal of a candidate hit (view space)
vec3 CandidateNormal (rayQueryEXT q)
{
	RTInstance r = inst[rayQueryGetIntersectionInstanceCustomIndexEXT (q, false) + rayQueryGetIntersectionGeometryIndexEXT (q, false)];
	uint prim = uint (rayQueryGetIntersectionPrimitiveIndexEXT (q, false));
	vec2 bc = rayQueryGetIntersectionBarycentricsEXT (q, false);
	vec3 w = vec3 (1.0 - bc.x - bc.y, bc.x, bc.y);
	vec3 n = vec3 (0.0);
	for (int k = 0; k < 3; k++) {
		uint i = r.firstIndex + prim * 3u + uint (k);
		uint word = RTUints (r.idx).u[i >> 1];
		uint vi = ((i & 1u) != 0u ? word >> 16 : word & 0xffffu) * 8u;
		RTFloats v = RTFloats (r.vtx);
		n += w[k] * vec3 (v.f[vi + 3u], v.f[vi + 4u], v.f[vi + 5u]);
	}
	return mat3 (rayQueryGetIntersectionObjectToWorldEXT (q, false)) * n;
}

// Light from a local light at lp reaching o: traced from the light. Emitters
// often sit inside their vessel's hull: surfaces the ray leaves from inside
// (normal along the ray) do not block it, those it meets from outside do.
// An extended source (a flame) is not blocked by its own vessel within
// skip of where the ray leaves it (the nozzle it streams from)
bool LightOccluded (vec3 lp, vec3 o, uint owner, float skip)
{
	vec3 d = o - lp;
	float t = length (d);
	d /= t;
	if (!RayFinite (lp, d, t)) return false;
	rayQueryEXT q;
	rayQueryInitializeEXT (q, tlas, gl_RayFlagsNoOpaqueEXT, MASK_ALL, lp, 0.0, d, t);
	while (rayQueryProceedEXT (q)) {
		if (rayQueryGetIntersectionTypeEXT (q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
		if (dot (CandidateNormal (q), d) > 0.0) continue; // leaving a surface
		if (skip > 0.0 && rayQueryGetIntersectionTEXT (q, false) < skip
			&& inst[rayQueryGetIntersectionInstanceCustomIndexEXT (q, false) + rayQueryGetIntersectionGeometryIndexEXT (q, false)].owner == owner) continue;
		if (!CandidateSolid (q)) continue;
		rayQueryConfirmIntersectionEXT (q);
		rayQueryTerminateEXT (q);
	}
	return rayQueryGetIntersectionTypeEXT (q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// distance of a hit (the first found, not necessarily the nearest; tMax if none)
float HitDist (vec3 o, vec3 d, float tMax, uint mask)
{
	if (!RayFinite (o, d, tMax)) return tMax;
	rayQueryEXT q;
	rayQueryInitializeEXT (q, tlas, gl_RayFlagsTerminateOnFirstHitEXT, mask, o, 0.0, d, tMax);
	while (rayQueryProceedEXT (q))
		if (rayQueryGetIntersectionTypeEXT (q, false) == gl_RayQueryCandidateIntersectionTriangleEXT && CandidateSolid (q))
			rayQueryConfirmIntersectionEXT (q);
	return rayQueryGetIntersectionTypeEXT (q, true) != gl_RayQueryCommittedIntersectionNoneEXT ? rayQueryGetIntersectionTEXT (q, true) : tMax;
}

// a direction within a cone of half-angle asin(s) around unit vector a
vec3 InCone (vec3 a, float s, vec2 u)
{
	vec3 t = normalize (abs (a.z) < 0.999 ? cross (vec3 (0, 0, 1), a) : cross (vec3 (1, 0, 0), a));
	vec3 b = cross (a, t);
	float r = s * sqrt (u.x), ph = 2.0 * PI * u.y;
	return normalize (a + (t * cos (ph) + b * sin (ph)) * r);
}

void main ()
{
	ivec2 p = ivec2 (gl_GlobalInvocationID.xy);
	if (p.x >= int (pc.size.x) || p.y >= int (pc.size.y)) return;
	vec4 d = texelFetch (prepass, p, 0);
	float z = d.w;
	if (z <= 0.0) {
		imageStore (rawA, p, vec4 (1.0));
		imageStore (rawL, p, vec4 (1.0));
		return;
	}
	vec3 N = d.xyz;
	vec3 P = ViewPos (vec2 (p) + 0.5, z);
	vec3 o = P + N * (0.001 * z + 0.01); // off the surface
	// (a point of the sea the swell moved, near the camera: the scene's sea
	// is its mean surface; rays start above that, or troughs are in its shade)
	vec3 oSw;
	bool swell = SwellBand (o, oSw);
	vec4 u = vec4 (Hash4 (uvec3 (p, uint (pc.frame)))) / 4294967296.0;
	vec4 u2 = vec4 (Hash4 (uvec3 (p, uint (pc.frame) + 7919u))) / 4294967296.0;

	// sun
	vec3 Ls = frame.sunDir.xyz;
	float sun = 1.0;
	if (dot (N, Ls) > -0.05) {
		vec3 dir = InCone (Ls, sin (pc.sunRadius), u.xy);
		// (the sea raised and lowered by the swell near the camera (swell.glsl)
		// while the terrain the rays meet is its mean surface: a trough is not
		// in the flat sea's shadow; vessels' shadows from where it is)
		if (swell)
			sun = (Occluded (o, dir, 1e6, MASK_OBJECTS) || Occluded (oSw, dir, 1e6, MASK_ALL & ~MASK_OBJECTS)) ? 0.0 : 1.0;
		else
			sun = Occluded (o, dir, 1e6, MASK_ALL) ? 0.0 : 1.0;
	}

	// ambient occlusion by vessels and bases (terrain relief is far coarser
	// than the radius, and rays starting on it are slow)
	float ao = 1.0;
	uint aoMask = MASK_OBJECTS;
	if (z < pc.aoMaxDist) {
		vec3 t = normalize (abs (N.z) < 0.999 ? cross (vec3 (0, 0, 1), N) : cross (vec3 (1, 0, 0), N));
		vec3 b = cross (N, t);
		// one cosine-weighted ray (accumulation over frames does the rest)
		float sr = sqrt (u.z), ph = 2.0 * PI * u.w;
		vec3 dir = normalize (t * sr * cos (ph) + b * sr * sin (ph) + N * sqrt (max (0.0, 1.0 - u.z)));
		float h = HitDist (o, dir, pc.aoRadius, aoMask) / pc.aoRadius;
		float occ = 1.0 - h * h; // nearer occluders block more of the ambient light
		ao = mix (1.0 - occ, 1.0, smoothstep (0.5 * pc.aoMaxDist, pc.aoMaxDist, z));
	}

	// the lit planet (vessels and bases occlude it)
	float planet = 1.0;
	if (frame.planetLight.w > 0.0 && dot (N, frame.planetDir.xyz) > -frame.planetDir.w)
		planet = Occluded (o, InCone (frame.planetDir.xyz, frame.planetDir.w, u2.zw), 1e6, MASK_OBJECTS) ? 0.0 : 1.0;

	// local lights. The points of one vessel's flames (an extended source)
	// share a ray: towards one of them, chosen at random per pixel and frame
	// (the filter accumulates over frames), its visibility for all
	vec4 lv = vec4 (1.0);
	int nl = min (int (pc.nLights), int (frame.lightCount.x));
	bool shared_[4] = bool[4] (false, false, false, false);
	for (int i = 0; i < nl; i++) {
		if (shared_[i]) continue;
		LocalLight l = frame.lights[i];
		if (l.dir.w < 1.5 && l.att.w > 0.0) {
			int group[4], ng = 0;
			for (int k = i; k < nl; k++)
				if (frame.lights[k].dir.w < 1.5 && frame.lights[k].att.w > 0.0 && frame.lights[k].spot.y == l.spot.y) group[ng++] = k;
			if (ng > 1) {
				vec4 rg = vec4 (Hash4 (uvec3 (p, uint (pc.frame) * 4u + 977u))) / 4294967296.0;
				l = frame.lights[group[min (int (rg.x * float (ng)), ng - 1)]];
				for (int k = 1; k < ng; k++) shared_[group[k]] = true;
			}
		}
		if (l.dir.w > 2.5) { // a star: towards it over its disc (soft), objects only, far
			if (dot (N, l.dir.xyz) <= 0.0) continue;
			vec4 rs = vec4 (Hash4 (uvec3 (p, uint (pc.frame) * 4u + uint (i) + 101u))) / 4294967296.0;
			lv[i] = Occluded (o, InCone (l.dir.xyz, sin (l.att.w), rs.xy), 1e6, MASK_OBJECTS) ? 0.0 : 1.0;
			continue;
		}
		vec3 Lv = l.pos.xyz - o;
		float dist = length (Lv);
		// (a point light's source radius: an extended source (a flame), lit
		// beyond the horizon of its centre: lights.glsl)
		float rad = l.dir.w < 1.5 ? l.att.w : 0.0;
		// (beyond LIGHT_SHADOW_REACH unshadowed: a launch's flames light the
		// ground for kilometres, where long rays over the terrain cost much
		// and the vessels' shadows are lost in the distance)
		if (dist > min (l.pos.w, LIGHT_SHADOW_REACH) || dist < 1e-3 || dot (N, Lv) <= -rad) continue;
		if (l.dir.w > 1.5 && dot (-Lv / dist, l.dir.xyz) < l.spot.x) continue; // outside the spot's cone
		// a point within 0.15 m of the light: slightly soft shadows; within an
		// extended source, a point of its half towards the surface (its
		// visible side; soft shadows of the size of a flame), not blocked by
		// its own vessel near it
		vec4 r = vec4 (Hash4 (uvec3 (p, uint (pc.frame) * 4u + uint (i) + 101u))) / 4294967296.0;
		vec3 j = (r.xyz * 2.0 - 1.0) * 0.15;
		if (rad > 0.0 && dist < 30.0 * rad) { // (farther: about a point; coherent rays)
			float ph = 2.0 * PI * r.y, cz = r.x * 2.0 - 1.0, sz = sqrt (max (1.0 - cz * cz, 0.0));
			j = vec3 (sz * cos (ph), sz * sin (ph), cz) * (rad * pow (r.z, 1.0 / 3.0));
			if (dot (j, Lv) > 0.0) j = -j;
		}
		// (spot light emitters inside the hull: from where the beam leaves it)
		vec3 lp = l.pos.xyz + (l.dir.w > 1.5 ? l.dir.xyz * l.spot.z : vec3 (0.0));
		lv[i] = LightOccluded (lp + j, o, uint (l.spot.y + 0.5), 1.5 * rad) ? 0.0 : 1.0;
	}
	for (int i = 1; i < nl; i++) // (the shared rays' visibility)
		if (shared_[i])
			for (int k = 0; k < i; k++)
				if (!shared_[k] && frame.lights[k].dir.w < 1.5 && frame.lights[k].att.w > 0.0 && frame.lights[k].spot.y == frame.lights[i].spot.y) { lv[i] = lv[k]; break; }
	imageStore (rawA, p, vec4 (sun, ao, planet, 1.0));
	imageStore (rawL, p, lv);
}
