// Ray traced lighting visibility, tracing (one frame's noisy estimate per
// pixel of the prepass): the sun (a ray to a random point of its disc: soft
// shadows that harden at contact), ambient occlusion (a cosine-weighted
// ray within a radius), the lit planet nearby (a ray to a random point of
// its disc, vessels and bases only), and the local lights with shadows (a
// ray to a random point of a small sphere around each).

#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

#include "rtlight.glsl"

#define FRAME_SET 1
#include "frame.glsl"

layout(set = 2, binding = 0) uniform accelerationStructureEXT tlas;
struct RTInstance { uvec2 vtx, idx; uint firstIndex, tex, flags, owner; vec4 diffuse, emissive, pbr, uv; }; // (rt.glsl)
layout(set = 2, binding = 1, std430) readonly buffer Instances { RTInstance inst[]; };

const uint MASK_ALL = 0xFFu, MASK_OBJECTS = 0x01u; // (terrain: 0x02)
const float PI = 3.14159265;

uvec4 Hash4 (uvec3 v)
{
	uvec4 x = uvec4 (v, v.x ^ v.y);
	x = x * 1664525u + 1013904223u;
	x.x += x.y * x.w; x.y += x.z * x.x; x.z += x.x * x.y; x.w += x.y * x.z;
	x ^= x >> 16u;
	x.x += x.y * x.w; x.y += x.z * x.x; x.z += x.x * x.y; x.w += x.y * x.z;
	return x;
}

bool Occluded (vec3 o, vec3 d, float tMax, uint mask)
{
	rayQueryEXT q;
	rayQueryInitializeEXT (q, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, mask, o, 0.0, d, tMax);
	while (rayQueryProceedEXT (q)) {}
	return rayQueryGetIntersectionTypeEXT (q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// Light from a local light at distance tMax: emitters sit in or on their
// vessel's hull, whose surface near them does not count
bool LightOccluded (vec3 o, vec3 d, float tMax, uint owner)
{
	// up to 3 m before the light: any surface; then all but the own hull
	float tNear = tMax - 3.0;
	if (tNear > 0.0 && Occluded (o, d, tNear, MASK_ALL)) return true;
	rayQueryEXT q;
	rayQueryInitializeEXT (q, tlas, gl_RayFlagsNoOpaqueEXT, MASK_ALL, o, max (tNear, 0.0), d, tMax);
	while (rayQueryProceedEXT (q)) {
		if (rayQueryGetIntersectionTypeEXT (q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
		uint ow = inst[rayQueryGetIntersectionInstanceCustomIndexEXT (q, false) + rayQueryGetIntersectionGeometryIndexEXT (q, false)].owner;
		if (ow == owner) continue;
		rayQueryConfirmIntersectionEXT (q);
		rayQueryTerminateEXT (q);
	}
	return rayQueryGetIntersectionTypeEXT (q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// distance of a hit (the first found, not necessarily the nearest; tMax if none)
float HitDist (vec3 o, vec3 d, float tMax, uint mask)
{
	rayQueryEXT q;
	rayQueryInitializeEXT (q, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, mask, o, 0.0, d, tMax);
	while (rayQueryProceedEXT (q)) {}
	return rayQueryGetIntersectionTypeEXT (q, true) != gl_RayQueryCommittedIntersectionNoneEXT ? rayQueryGetIntersectionTEXT (q, true) : tMax;
}

// a direction within a cone of half-angle asin(s) around unit vector a
vec3 InCone (vec3 a, float s, vec2 u)
{
	vec3 t = normalize (abs (a.z) < 0.999 ? cross (vec3 (0, 0, 1), a) : cross (vec3 (1, 0, 0), a));
	vec3 b = cross (a, t);
	float r = s * sqrt (u.x), ph = 2.0 * PI * u.y;
	return normalize (a + (t * cos (ph) + b * sin (ph)) * r);
}

void main ()
{
	ivec2 p = ivec2 (gl_GlobalInvocationID.xy);
	if (p.x >= int (pc.size.x) || p.y >= int (pc.size.y)) return;
	vec4 d = texelFetch (prepass, p, 0);
	float z = d.w;
	if (z <= 0.0) {
		imageStore (rawA, p, vec4 (1.0));
		imageStore (rawL, p, vec4 (1.0));
		return;
	}
	vec3 N = d.xyz;
	vec3 P = ViewPos (vec2 (p) + 0.5, z);
	vec3 o = P + N * (0.001 * z + 0.01); // off the surface
	vec4 u = vec4 (Hash4 (uvec3 (p, uint (pc.frame)))) / 4294967296.0;
	vec4 u2 = vec4 (Hash4 (uvec3 (p, uint (pc.frame) + 7919u))) / 4294967296.0;

	// sun
	vec3 Ls = frame.sunDir.xyz;
	float sun = 1.0;
	if (dot (N, Ls) > -0.05) sun = Occluded (o, InCone (Ls, sin (pc.sunRadius), u.xy), 1e6, MASK_ALL) ? 0.0 : 1.0;

	// ambient occlusion by vessels and bases (terrain relief is far coarser
	// than the radius, and rays starting on it are slow)
	float ao = 1.0;
	uint aoMask = MASK_OBJECTS;
	if (z < pc.aoMaxDist) {
		vec3 t = normalize (abs (N.z) < 0.999 ? cross (vec3 (0, 0, 1), N) : cross (vec3 (1, 0, 0), N));
		vec3 b = cross (N, t);
		// one cosine-weighted ray (accumulation over frames does the rest)
		float sr = sqrt (u.z), ph = 2.0 * PI * u.w;
		vec3 dir = normalize (t * sr * cos (ph) + b * sr * sin (ph) + N * sqrt (max (0.0, 1.0 - u.z)));
		float h = HitDist (o, dir, pc.aoRadius, aoMask) / pc.aoRadius;
		float occ = 1.0 - h * h; // nearer occluders block more of the ambient light
		ao = mix (1.0 - occ, 1.0, smoothstep (0.5 * pc.aoMaxDist, pc.aoMaxDist, z));
	}

	// the lit planet (vessels and bases occlude it)
	float planet = 1.0;
	if (frame.planetLight.w > 0.0 && dot (N, frame.planetDir.xyz) > -frame.planetDir.w)
		planet = Occluded (o, InCone (frame.planetDir.xyz, frame.planetDir.w, u2.zw), 1e6, MASK_OBJECTS) ? 0.0 : 1.0;

	// local lights
	vec4 lv = vec4 (1.0);
	int nl = min (int (pc.nLights), int (frame.lightCount.x));
	for (int i = 0; i < nl; i++) {
		LocalLight l = frame.lights[i];
		vec3 Lv = l.pos.xyz - o;
		float dist = length (Lv);
		if (dist > l.pos.w || dist < 1e-3 || dot (N, Lv) <= 0.0) continue;
		if (l.dir.w > 1.5 && dot (-Lv / dist, l.dir.xyz) < l.spot.x) continue; // outside the spot's cone
		// a point within 0.15 m of the light: slightly soft shadows
		vec4 r = vec4 (Hash4 (uvec3 (p, uint (pc.frame) * 4u + uint (i) + 101u))) / 4294967296.0;
		vec3 j = (r.xyz * 2.0 - 1.0) * 0.15;
		vec3 dir = l.pos.xyz + j - o;
		float dl = length (dir);
		lv[i] = LightOccluded (o, dir / dl, dl, uint (l.spot.y)) ? 0.0 : 1.0;
	}
	imageStore (rawA, p, vec4 (sun, ao, planet, 1.0));
	imageStore (rawL, p, lv);
}
