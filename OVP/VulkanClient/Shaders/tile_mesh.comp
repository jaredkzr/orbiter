// Tile meshes with the procedural terrain detail (PlanetSurface: as its
// ComputeMesh does on the CPU). One workgroup per tile: the elevation of
// the data, the detail's amplitude and fade come per grid point from the
// CPU (cheap); here the detail's height (DetHeight, the core's function),
// the positions, normals, skirts, the parent's shape for the morph, and
// the per-vertex detail stream, written into the tile's vertex buffer.

#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#include "detailcore.glsl"

layout(local_size_x = 256) in;

const int G = 64, V = G + 1, W = G + 3, M = G / 2 + 1; // (G: TileRenderer::GRID)
const int NV = V * V + 4 * V; // vertices: grid, then the skirts
const int NE = 5;             // per-vertex detail stream: amplitude, fade, morph target

struct Job {
	ivec4 refI;     // the tile's reference point d0 R [m] (d0: the centre's direction), integer part
	vec4 refF;      // ... fraction; w: the planet's radius R [m]
	vec4 ll;        // latitude and longitude of the centre, row and column steps [rad]
	vec4 off;       // offsets of the top row and left column from the centre [rad]; latitude limits (poles) relative to it
	vec4 d0;        // d0 (xyz)
	uvec2 outAddr;  // vertex buffer: NV vertices (8 floats), then NV detail records (NE floats)
	uvec2 ptsAddr;  // per point: data elevation, amplitude, fade (W*W, then the parent's M*M)
	vec4 sp;        // lmin, the parent's lmin, data spacing, the parent's data spacing [m]
	vec4 misc;      // skirt depth [m], parent (1/0), lsplit: the coarser detail is in the points' elevations [m],
	                // href: the points' elevations are relative to it [m]
};
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Jobs { Job job[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats { float f[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) coherent buffer OutFloats { float f[]; };

layout(push_constant) uniform Params {
	uvec2 jobs;
	uvec2 pad;
	vec4 prm;      // hurst, ridge, crater cells, crater depth
	vec4 prm2;     // pebble cells
} pc;

shared vec3 P[W * W]; // positions relative to the tile centre raised to href
// (the morph targets go through the output: the detail stream's records)

// The direction at latitude and longitude offsets (da, db) from the centre
// (lat0, lng0), relative to the centre's: by the identities for differences
// of sines and cosines, accurate in single precision for small offsets
vec3 DirOffset (float lat0, float lng0, float da, float db)
{
	float sa = sin (0.5 * da), sb = sin (0.5 * db);
	float dcl = -2.0 * sin (lat0 + 0.5 * da) * sa, dsl = 2.0 * cos (lat0 + 0.5 * da) * sa;
	float dcn = -2.0 * sin (lng0 + 0.5 * db) * sb, dsn = 2.0 * cos (lng0 + 0.5 * db) * sb;
	float cl0 = cos (lat0);
	return vec3 (dcl * cos (lng0 + db) + cl0 * dcn, dsl, dcl * sin (lng0 + db) + cl0 * dsn);
}

// a morph target, in the vertex's detail record
void SetT (OutFloats o, int idx, vec3 t)
{
	uint e = uint (NV * 8 + idx * NE);
	o.f[e + 2] = t.x, o.f[e + 3] = t.y, o.f[e + 4] = t.z;
}
vec3 GetT (OutFloats o, int idx)
{
	uint e = uint (NV * 8 + idx * NE);
	return vec3 (o.f[e + 2], o.f[e + 3], o.f[e + 4]);
}

void main ()
{
	Job jb = Jobs (pc.jobs).job[gl_WorkGroupID.x];
	Floats pts = Floats (jb.ptsAddr);
	OutFloats o = OutFloats (jb.outAddr);
	uint tid = gl_LocalInvocationID.x;
	float R = jb.refF.w, dlat = jb.ll.z, dlng = jb.ll.w;
	vec3 d0 = jb.d0.xyz;
	bool parent = jb.misc.y > 0.5;
	// offsets of grid point (i, j) from the centre (latitudes clamped at the poles)
	#define DA(i) clamp (jb.off.x - float (i) * dlat, jb.off.w, jb.off.z)
	#define DB(j) (jb.off.y + float (j) * dlng)

	// the grid with a border of one node
	for (uint k = tid; k < uint (W * W); k += 256u) {
		int i = int (k) / W, j = int (k) % W;
		vec3 dd = DirOffset (jb.ll.x, jb.ll.y, DA (i - 1), DB (j - 1));
		DetPoint pt = DetPointAt (jb.refI.xyz, jb.refF.xyz, dd * R);
		float h0 = pts.f[3 * k], A = pts.f[3 * k + 1], f = pts.f[3 * k + 2];
		// (without the pebbles: the normals are of the ground under them; the
		// shader shades the pebbles per pixel, their sharp edges would
		// alias on the grid)
		float h = h0 + DetHeight (pt, A, f, jb.sp.z, jb.sp.x, jb.misc.z, pc.prm, 0.0);
		// (d (R + href + h) - d0 (R + href): small, its rounding far below the
		// node spacing; d0 href is added when the vertices are written)
		P[k] = d0 * h + dd * (R + jb.misc.w + h);
	}
	// the parent's shape at its nodes (every second one)
	if (parent) {
		for (uint k = tid; k < uint (M * M); k += 256u) {
			int i = 2 * (int (k) / M), j = 2 * (int (k) % M);
			vec3 dd = DirOffset (jb.ll.x, jb.ll.y, DA (i), DB (j));
			DetPoint pt = DetPointAt (jb.refI.xyz, jb.refF.xyz, dd * R);
			uint q = uint (W * W) + k;
			float h0 = pts.f[3 * q], A = pts.f[3 * q + 1], f = pts.f[3 * q + 2];
			float h = h0 + DetHeight (pt, A, f, jb.sp.w, jb.sp.y, jb.misc.z, pc.prm, pc.prm2.x);
			SetT (o, i * V + j, d0 * h + dd * (R + jb.misc.w + h));
		}
	}
	memoryBarrierBuffer ();
	barrier ();
	// the vertices between the parent's: on its triangles' edges (its quads
	// split from top right to bottom left); without a parent: the tile's own
	for (uint k = tid; k < uint (V * V); k += 256u) {
		int i = int (k) / V, j = int (k) % V;
		if (!parent) { SetT (o, int (k), P[(i + 1) * W + (j + 1)]); continue; }
		if (!((i & 1) != 0) && !((j & 1) != 0)) continue;
		if ((i & 1) != 0 && (j & 1) != 0) SetT (o, int (k), (GetT (o, (i - 1) * V + j + 1) + GetT (o, (i + 1) * V + j - 1)) * 0.5);
		else if ((i & 1) != 0)            SetT (o, int (k), (GetT (o, (i - 1) * V + j) + GetT (o, (i + 1) * V + j)) * 0.5);
		else                              SetT (o, int (k), (GetT (o, i * V + j - 1) + GetT (o, i * V + j + 1)) * 0.5);
	}
	memoryBarrierBuffer ();
	barrier ();

	// vertices (NTVERTEX: position, normal, texture coordinates) and the
	// detail stream; the skirts hang below the edges
	float depth = jb.misc.x;
	uint ampBase = uint (NV * 8);
	for (uint k = tid; k < uint (V * V); k += 256u) {
		int i = int (k) / V, j = int (k) % V;
		uint pk = uint ((i + 1) * W + (j + 1));
		float da = DA (i);
		vec3 dd = DirOffset (jb.ll.x, jb.ll.y, da, DB (j));
		vec3 d = normalize (d0 + dd);
		DetPoint pt = DetPointAt (jb.refI.xyz, jb.refF.xyz, dd * R);
		float peb = DetPebbles (pt, pts.f[3 * pk + 2], jb.sp.z, jb.sp.x, pc.prm2.x, 0.0);
		vec3 href0 = d0 * jb.misc.w;
		vec3 p = P[pk] + d * peb + href0;
		vec3 nm = cross (P[(i + 2) * W + (j + 1)] - P[i * W + (j + 1)], P[(i + 1) * W + (j + 2)] - P[(i + 1) * W + j]);
		float len = length (nm);
		bool pole = da >= jb.off.z || da <= jb.off.w; // (at a pole the neighbours collapse: the vertical)
		nm = len > 1e-9 && !pole ? nm / len : d;
		if (dot (nm, d) < 0.0) nm = -nm;
		float A = pts.f[3 * pk + 1], f = pts.f[3 * pk + 2];
		vec3 t = GetT (o, int (k)) + href0;
		// (the vertex, and its skirt copies on the edges)
		for (int s = 0; s < 5; s++) {
			int idx = -1;
			if (s == 0) idx = int (k);
			else if (s == 1 && i == 0) idx = V * V + j;
			else if (s == 2 && i == G) idx = V * V + V + j;
			else if (s == 3 && j == 0) idx = V * V + 2 * V + i;
			else if (s == 4 && j == G) idx = V * V + 3 * V + i;
			if (idx < 0) continue;
			vec3 off = s == 0 ? vec3 (0.0) : d * depth;
			vec3 pp = p - off, tt = t - off;
			uint b = uint (idx) * 8u;
			o.f[b] = pp.x, o.f[b + 1] = pp.y, o.f[b + 2] = pp.z;
			o.f[b + 3] = nm.x, o.f[b + 4] = nm.y, o.f[b + 5] = nm.z;
			o.f[b + 6] = float (j) / float (G), o.f[b + 7] = float (i) / float (G);
			uint e = ampBase + uint (idx) * uint (NE);
			o.f[e] = A, o.f[e + 1] = f;
			o.f[e + 2] = tt.x, o.f[e + 3] = tt.y, o.f[e + 4] = tt.z;
		}
	}
}
