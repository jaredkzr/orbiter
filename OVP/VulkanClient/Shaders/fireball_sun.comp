// Crash fireballs (Fireball.cpp): for each cell of a fireball's grid (at
// half its resolution: soft) the optical depth towards the sun (its
// self-shadowing: the sunlit side bright, the far side dark; the march adds
// the first few cells at full resolution), towards the sky above (its
// underside darker in the ambient light), and the fire's own light there:
// the radiance of the burning gas seen from the cell looking in towards
// the ball's centre (the soot wrapping the fire lit by it from inside, the
// cap's underside glowing at night), marched through its grid (A:
// fireball_grid.comp).
// Out: B (sun, sky optical depth; the fire's luminance looking in)

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "frame.glsl"
#define FB_SET 1
#define FB_BINDING 6
#include "fireball.glsl"

layout(set = 1, binding = 1, rgba16f) uniform writeonly image3D outB;
layout(set = 1, binding = 3) uniform sampler3D gridA;

layout(push_constant) uniform Pass {
	uint base;
	uint count;
} pc;

// the box's exit along unit direction dir from p (ball space)
float Exit (FireballParams P, vec3 p, vec3 dir)
{
	vec3 inv = 1.0 / mix (dir, vec3 (1e-6), lessThan (abs (dir), vec3 (1e-6)));
	vec3 tb = max ((P.boxMin.xyz - p) * inv, (P.boxMax.xyz - p) * inv);
	return min (min (tb.x, tb.y), tb.z);
}

float Cell (FireballParams P)
{
	vec3 size = P.boxMax.xyz - P.boxMin.xyz;
	return min (min (size.x / float (FB_GX), size.y / float (FB_GY)), size.z / float (FB_GZ));
}

// optical depth from p (ball space) along unit direction dir, up to the box
float Depth (FireballParams P, vec3 p, vec3 dir, int nMax)
{
	vec3 size = P.boxMax.xyz - P.boxMin.xyz;
	float tExit = Exit (P, p, dir);
	// (steps of about a cell and a half)
	float cell = Cell (P);
	int n = clamp (int (ceil (tExit / (1.5 * cell))), 1, nMax);
	float dt = tExit / float (n), tau = 0.0;
	float r = P.shape.x;
	for (int i = 0; i < n; i++) {
		vec3 x = p + dir * ((float (i) + 0.5) * dt);
		vec4 A = textureLod (gridA, FbGridCoord ((x - P.boxMin.xyz) / size, P.boxMin.w), 0.0);
		tau += A.x * (FB_SIGMA_FLAME + FB_SIGMA_SOOT * A.z) * P.flow.w * P.heat.w;
		if (tau * dt / r > 12.0) break;
	}
	return tau * dt / r;
}

// the fire's luminance seen from p looking in towards the ball's centre
// (through its soot; the burning gas's blackbody emission, FbPlanck), on to
// the far side: what lights the soot there from inside
float Inward (FireballParams P, vec3 p, int nMax)
{
	vec3 size = P.boxMax.xyz - P.boxMin.xyz;
	float r = P.shape.x;
	// (towards the ball's centre - the hot gas lifted with it, its base
	// drawn in; from the centre itself: straight up)
	vec3 dir = length (p) > 0.05 * r ? -normalize (p) : vec3 (0.0, 0.0, 1.0);
	float tExit = min (Exit (P, p, dir), 2.5 * r);
	float cell = Cell (P);
	int n = clamp (int (ceil (tExit / (1.5 * cell))), 1, nMax);
	float dt = tExit / float (n);
	float T = 1.0, L = 0.0;
	for (int i = 0; i < n; i++) {
		vec3 x = p + dir * ((float (i) + 0.5) * dt);
		vec4 A = textureLod (gridA, FbGridCoord ((x - P.boxMin.xyz) / size, P.boxMin.w), 0.0);
		if (A.x < 0.002) continue;
		float sig = A.x * (FB_SIGMA_FLAME + FB_SIGMA_SOOT * A.z) * P.flow.w * P.heat.w / r;
		float a = 1.0 - exp (-sig * dt);
		float alb = mix (0.05, 0.2, A.z);
		// (the march erodes about a third of its density: its emission seen
		// from closer; as bright as the march's, about)
		L += T * a * (1.0 - alb) * dot (FbPlanck (A.y * 1000.0), vec3 (0.2126, 0.7152, 0.0722));
		T *= 1.0 - a;
		if (T < 0.01) break;
	}
	return L;
}

void main ()
{
	ivec3 id = ivec3 (gl_GlobalInvocationID);
	uint k = uint (id.z / FB_BZ);
	if (k >= pc.count || id.x >= FB_BX || id.y >= FB_BY) return;
	FireballParams P = fireballs[pc.base + k];
	if (P.mode.x > 0.5) { imageStore (outB, id, vec4 (0.0)); return; } // (the free cloud: its sun shadow analytic, fireball.frag)
	vec3 uvw = (vec3 (id.x, id.y, id.z % FB_BZ) + 0.5) / vec3 (FB_BX, FB_BY, FB_BZ);
	vec3 p = mix (P.boxMin.xyz, P.boxMax.xyz, uvw);
	vec3 sun = normalize (mat3 (P.toBall) * frame.sunDir.xyz);
	float ts = Depth (P, p, sun, 64);
	float tu = Depth (P, p, vec3 (0.0, 0.0, 1.0), 32);
	float li = Inward (P, p, 48);
	imageStore (outB, id, vec4 (ts, tu, li, 0.0));
}
