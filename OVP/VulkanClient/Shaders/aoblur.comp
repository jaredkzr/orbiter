// 4x4 depth-aware box blur of the ambient occlusion, which removes the
// 4x4 sampling pattern without blurring across depth edges

#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D prepass;
layout(set = 0, binding = 1, r32f) uniform readonly image2D aoIn;
layout(set = 0, binding = 2, r32f) uniform writeonly image2D aoOut;

layout(push_constant) uniform Params {
	vec2 focal;
	vec2 size;
} pc;

void main ()
{
	ivec2 p = ivec2 (gl_GlobalInvocationID.xy);
	ivec2 sz = ivec2 (pc.size);
	if (p.x >= sz.x || p.y >= sz.y) return;
	float z = texelFetch (prepass, p, 0).w;
	if (z <= 0.0) { imageStore (aoOut, p, vec4 (1.0)); return; }
	float sum = 0.0, wsum = 0.0;
	for (int y = -2; y < 2; y++)
		for (int x = -2; x < 2; x++) {
			ivec2 q = clamp (p + ivec2 (x, y), ivec2 (0), sz - 1);
			float zq = texelFetch (prepass, q, 0).w;
			float w = abs (zq - z) < 0.05 * z + 0.05 ? 1.0 : 0.0;
			sum += imageLoad (aoIn, q).r * w;
			wsum += w;
		}
	imageStore (aoOut, p, vec4 (wsum > 0.0 ? sum / wsum : 1.0));
}
